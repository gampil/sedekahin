# Firebase Configuration
# Dapatkan dari Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Apps Script Backend URL
# Dapatkan setelah deploy Apps Script sebagai Web App
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Notes:
# - Jika VITE_FIREBASE_API_KEY tidak diisi atau "YOUR_FIREBASE_API_KEY", website akan berjalan dalam mode DEMO
# - Mode demo menggunakan data lokal, semua fitur bisa dicoba tanpa setup Firebase
# - Untuk production, isi semua variabel di atas dengan credential yang benar
